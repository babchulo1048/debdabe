# Copy to .env and fill in. Without the Supabase keys the app runs in mock mode (browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Shown on the login page; leave empty on company installs.
VITE_DEMO_PASSWORD=
# Model server, e.g. http://<server-ip>:7860 (see model-server/README.md)
VITE_MODEL_URL=

# Server only (no VITE_): Verify Mela payment checking (testing)
VERIFYMELA_API_KEY=
VERIFYMELA_RECEIVER_NAMES=
